# Copy this to .env and fill in your values
# Never commit .env to version control

# SAP AI Core — get from BTP service key
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# AI Core deployment IDs — from AI Launchpad
EMBEDDING_DEPLOYMENT_ID=
EMBEDDING_MODEL_NAME=gemini-embedding

# LLM deployment (Gemini 2.5 Pro via AI Core)
LLM_DEPLOYMENT_ID=
LLM_MODEL_NAME=gemini-2.5-pro

# SAP HANA Cloud — get from BTP HANA Cloud Central
HANA_HOST=
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=
HANA_SCHEMA=SVA2
